{
  "openapi": "3.0.0",
  "info": {
    "title": "Paradise Circus API",
    "version": "1.0.0",
    "description": "Workshop booking and community platform API for flow artists. Consumed by the web app and mobile app."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development"
    },
    {
      "url": "https://paradisecircus.com/api",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Clerk session token"
      }
    },
    "schemas": {
      "artistUsernameParamsSchema": {
        "type": "object",
        "properties": {
          "username": {
            "$ref": "#/components/schemas/usernameParamSchema"
          }
        },
        "required": [
          "username"
        ]
      },
      "artistProfileResponseSchema": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/artistProfileUserSchema"
          },
          "props": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/artistUserPropSchema"
            }
          },
          "workshops": {
            "$ref": "#/components/schemas/artistProfileWorkshopsSchema"
          }
        },
        "required": [
          "user",
          "props",
          "workshops"
        ]
      },
      "artistsListResponseSchema": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/artistListItemSchema"
        }
      },
      "authMeResponseSchema": {
        "type": "object",
        "properties": {
          "isAdmin": {
            "type": "boolean",
            "description": "Whether the user is an admin"
          },
          "isInstructor": {
            "type": "boolean",
            "description": "Whether the user is an instructor"
          },
          "userId": {
            "type": "string",
            "nullable": true,
            "description": "Clerk user ID when signed in"
          }
        },
        "required": [
          "isAdmin",
          "isInstructor",
          "userId"
        ]
      },
      "icsContentSchema": {
        "type": "string",
        "description": "ICS calendar file content (text/calendar)"
      },
      "propsListResponseSchema": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/propItemSchema"
        }
      },
      "timetableQuerySchema": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/components/schemas/dateStringSchema"
          },
          "end": {
            "$ref": "#/components/schemas/dateStringSchema"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "timetablePublicResponseSchema": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/timetableEventSchema"
        }
      },
      "timetableAuthQuerySchema": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/components/schemas/dateStringSchema"
          },
          "end": {
            "$ref": "#/components/schemas/dateStringSchema"
          },
          "userId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "timetableResponseSchema": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/timetableEventSchema"
        }
      },
      "dateStringSchema": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "usernameParamSchema": {
        "type": "string",
        "minLength": 3,
        "maxLength": 30,
        "pattern": "^[a-zA-Z0-9._-]+$"
      },
      "propItemSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Prop ID"
          },
          "name": {
            "type": "string",
            "description": "Prop name"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "artistPropSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Prop name"
          },
          "skillLevel": {
            "type": "integer",
            "description": "Skill level 0-5"
          }
        },
        "required": [
          "name",
          "skillLevel"
        ]
      },
      "artistListItemSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Artist ID"
          },
          "name": {
            "type": "string",
            "description": "Display name"
          },
          "avatar": {
            "type": "string",
            "description": "Avatar URL"
          },
          "username": {
            "type": "string",
            "description": "Username"
          },
          "isInstructor": {
            "type": "boolean",
            "description": "Whether the artist is an instructor"
          },
          "workshopCount": {
            "type": "integer",
            "description": "Number of workshops taught"
          },
          "props": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/artistPropSchema"
            },
            "description": "Props and skill levels"
          },
          "videoCount": {
            "type": "integer",
            "description": "Total video count"
          },
          "bio": {
            "type": "string",
            "description": "Artist bio"
          },
          "instagramHandle": {
            "type": "string",
            "description": "Instagram handle"
          },
          "availableForPerformances": {
            "type": "boolean",
            "description": "Available for performances"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "isInstructor",
          "workshopCount",
          "props",
          "videoCount",
          "availableForPerformances"
        ]
      },
      "artistUserPropSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "propId": {
            "type": "integer"
          },
          "propName": {
            "type": "string"
          },
          "skillLevel": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "description": "ISO 8601 datetime"
          }
        },
        "required": [
          "id",
          "userId",
          "propId",
          "propName",
          "skillLevel",
          "createdAt"
        ]
      },
      "workshopEventSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "instructor": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string"
          },
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "currentParticipants": {
            "type": "integer"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "isRecurring": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "instructor",
          "date",
          "startTime",
          "endTime",
          "currentParticipants",
          "location",
          "isRecurring"
        ]
      },
      "artistProfileUserSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "clerkUserId": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "isInstructor": {
            "type": "boolean"
          },
          "isAdmin": {
            "type": "boolean"
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "instagramHandle": {
            "type": "string",
            "nullable": true
          },
          "patreonPage": {
            "type": "string",
            "nullable": true
          },
          "website": {
            "type": "string",
            "nullable": true
          },
          "youtubeVideos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "vimeoVideos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "experienceStartDate": {
            "type": "string",
            "nullable": true
          },
          "performanceStyle": {
            "type": "string",
            "nullable": true
          },
          "availableForPerformances": {
            "type": "boolean"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "avatarImageUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "description": "ISO 8601 datetime"
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO 8601 datetime"
          }
        },
        "required": [
          "id",
          "clerkUserId",
          "email",
          "username",
          "displayName",
          "isInstructor",
          "isAdmin",
          "bio",
          "instagramHandle",
          "patreonPage",
          "website",
          "youtubeVideos",
          "vimeoVideos",
          "experienceStartDate",
          "performanceStyle",
          "availableForPerformances",
          "location",
          "avatarImageUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "artistProfileWorkshopsSchema": {
        "type": "object",
        "properties": {
          "upcoming": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/workshopEventSchema"
            }
          },
          "past": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/workshopEventSchema"
            }
          }
        },
        "required": [
          "upcoming",
          "past"
        ]
      },
      "userRefSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "username",
          "displayName"
        ]
      },
      "timetableInstructorProfileSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string"
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "instagramHandle": {
            "type": "string",
            "nullable": true
          },
          "avatarImageUrl": {
            "type": "string",
            "nullable": true
          },
          "youtubeVideos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "vimeoVideos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "experienceStartDate": {
            "type": "string",
            "nullable": true
          },
          "performanceStyle": {
            "type": "string",
            "nullable": true
          },
          "availableForPerformances": {
            "type": "boolean"
          },
          "location": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "displayName",
          "username",
          "bio",
          "instagramHandle",
          "avatarImageUrl",
          "youtubeVideos",
          "vimeoVideos",
          "experienceStartDate",
          "performanceStyle",
          "availableForPerformances",
          "location"
        ]
      },
      "timetableEventSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "instructor": {
            "type": "string",
            "nullable": true
          },
          "instructorId": {
            "type": "integer",
            "nullable": true
          },
          "date": {
            "type": "string"
          },
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "whatToBring": {
            "type": "string",
            "nullable": true
          },
          "isWorkshop": {
            "type": "boolean"
          },
          "currentParticipants": {
            "type": "integer"
          },
          "propId": {
            "type": "integer",
            "nullable": true
          },
          "isPublished": {
            "type": "boolean"
          },
          "isRecurring": {
            "type": "boolean"
          },
          "recurringSeriesId": {
            "type": "string",
            "nullable": true
          },
          "recurringUntil": {
            "type": "string",
            "nullable": true
          },
          "recapVideoId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "description": "ISO 8601 datetime"
          },
          "instructorProfile": {
            "allOf": [
              {
                "$ref": "#/components/schemas/timetableInstructorProfileSchema"
              }
            ]
          },
          "lastUpdatedByUser": {
            "allOf": [
              {
                "$ref": "#/components/schemas/userRefSchema"
              }
            ]
          },
          "approvedByUser": {
            "allOf": [
              {
                "$ref": "#/components/schemas/userRefSchema"
              }
            ]
          },
          "instructorDisplayName": {
            "type": "string",
            "nullable": true
          },
          "instructorAvatarUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "instructor",
          "instructorId",
          "date",
          "startTime",
          "endTime",
          "location",
          "whatToBring",
          "isWorkshop",
          "currentParticipants",
          "propId",
          "isPublished",
          "isRecurring",
          "recurringSeriesId",
          "recurringUntil",
          "recapVideoId",
          "createdAt",
          "instructorProfile",
          "instructorDisplayName",
          "instructorAvatarUrl"
        ]
      },
      "createParticipationSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/positiveIntSchema"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "eventId",
          "name",
          "email"
        ]
      },
      "addCommentSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "eventId",
          "content"
        ]
      },
      "profileSchema": {
        "type": "object",
        "properties": {
          "username": {
            "$ref": "#/components/schemas/usernameParamSchema"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "instagramHandle": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._]*[a-zA-Z0-9_])?$",
            "nullable": true
          }
        },
        "required": [
          "username",
          "displayName"
        ]
      },
      "createEventSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "$ref": "#/components/schemas/dateStringSchema"
          },
          "start_time": {
            "type": "string",
            "minLength": 1
          },
          "end_time": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "description",
          "date",
          "start_time",
          "end_time",
          "location"
        ]
      },
      "positiveIntSchema": {
        "type": "integer",
        "minimum": 0,
        "exclusiveMinimum": true
      }
    },
    "responses": {
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Invalid request parameters"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Authentication required"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Access denied"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Resource not found"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "An unexpected error occurred"
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/artists": {
      "get": {
        "operationId": "get-artists",
        "summary": "List all artists (instructors and performers)",
        "description": "Returns all artists with their props, workshop counts, and profile info. Used by the mobile app and artists page.",
        "tags": [
          "Artists"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/artistsListResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/artists/{username}": {
      "get": {
        "operationId": "get-artists-{username}",
        "summary": "Get artist profile by username",
        "description": "Returns full artist profile with props and upcoming workshops. Used by the mobile app artist detail screen.",
        "tags": [
          "Artists"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "username",
            "schema": {},
            "required": true,
            "example": "johndoe"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/artistProfileResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "get-auth-me",
        "summary": "Get current user auth context",
        "description": "Returns the current user's auth context (isAdmin, isInstructor, userId). Used for client-side navigation and timetable. Returns nulls when signed out.",
        "tags": [
          "Auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/authMeResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/calendar/{token}": {
      "get": {
        "operationId": "get-calendar-{token}",
        "summary": "Get calendar file for participation (ICS)",
        "description": "Returns an ICS calendar file for a booking. Requires valid confirmation token.",
        "tags": [
          "Calendar"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/icsContentSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/cancel-participation": {
      "get": {
        "operationId": "get-cancel-participation",
        "summary": "",
        "description": "",
        "tags": [
          "Cancel-participation"
        ],
        "parameters": [],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/event/{id}/calendar": {
      "get": {
        "operationId": "get-event-{id}-calendar",
        "summary": "Get calendar file for event (ICS)",
        "description": "Returns an ICS calendar file for a published event. No booking required.",
        "tags": [
          "Event"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/icsContentSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/props": {
      "get": {
        "operationId": "get-props",
        "summary": "List all flow art props",
        "description": "Returns all props from the catalog (staff, poi, hoops, etc.). Used by the mobile app and profile autocomplete.",
