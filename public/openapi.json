{
  "openapi": "3.0.0",
  "info": {
    "title": "Paradise Circus API",
    "version": "1.0.0",
    "description": "Workshop booking and community platform API for flow artists. Consumed by the web app and mobile app."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development"
    },
    {
      "url": "https://paradisecircus.com/api",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Clerk session token"
      }
    },
    "schemas": {
      "artistUsernameParamsSchema": {
        "type": "object",
        "properties": {
          "username": {
            "$ref": "#/components/schemas/usernameParamSchema"
          }
        },
        "required": [
          "username"
        ]
      },
      "authMeResponseSchema": {
        "type": "object",
        "properties": {
          "isAdmin": {
            "type": "boolean",
            "description": "Whether the user is an admin"
          },
          "isInstructor": {
            "type": "boolean",
            "description": "Whether the user is an instructor"
          },
          "userId": {
            "type": "string",
            "nullable": true,
            "description": "Clerk user ID when signed in"
          }
        },
        "required": [
          "isAdmin",
          "isInstructor",
          "userId"
        ]
      },
      "timetableQuerySchema": {
        "type": "object",
        "properties": {
          "start": {
            "$ref": "#/components/schemas/dateStringSchema"
          },
          "end": {
            "$ref": "#/components/schemas/dateStringSchema"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "dateStringSchema": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "usernameParamSchema": {
        "type": "string",
        "minLength": 3,
        "maxLength": 30,
        "pattern": "^[a-zA-Z0-9._-]+$"
      },
      "createBookingSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "$ref": "#/components/schemas/positiveIntSchema"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "eventId",
          "name",
          "email"
        ]
      },
      "addCommentSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "eventId",
          "content"
        ]
      },
      "profileSchema": {
        "type": "object",
        "properties": {
          "username": {
            "$ref": "#/components/schemas/usernameParamSchema"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "instagramHandle": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._]*[a-zA-Z0-9_])?$",
            "nullable": true
          }
        },
        "required": [
          "username",
          "displayName"
        ]
      },
      "createEventSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "$ref": "#/components/schemas/dateStringSchema"
          },
          "start_time": {
            "type": "string",
            "minLength": 1
          },
          "end_time": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "description",
          "date",
          "start_time",
          "end_time",
          "location"
        ]
      },
      "positiveIntSchema": {
        "type": "integer",
        "minimum": 0,
        "exclusiveMinimum": true
      }
    },
    "responses": {
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Invalid request parameters"
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Authentication required"
                }
              }
            }
          }
        }
      },
      "403": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Access denied"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "Resource not found"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "example": "An unexpected error occurred"
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/artists": {
      "get": {
        "operationId": "get-artists",
        "summary": "List all artists (instructors and performers)",
        "description": "Returns all artists with their props, workshop counts, and profile info. Used by the mobile app and artists page.",
        "tags": [
          "Artists"
        ],
        "parameters": [],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/artists/{username}": {
      "get": {
        "operationId": "get-artists-{username}",
        "summary": "Get artist profile by username",
        "description": "Returns full artist profile with props and upcoming workshops. Used by the mobile app artist detail screen.",
        "tags": [
          "Artists"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "username",
            "schema": {},
            "required": true,
            "example": "johndoe"
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "get-auth-me",
        "summary": "Get current user auth context",
        "description": "Returns the current user's auth context (isAdmin, isInstructor, userId). Used for client-side navigation and timetable. Returns nulls when signed out.",
        "tags": [
          "Auth"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/authMeResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/calendar/{token}": {
      "get": {
        "operationId": "get-calendar-{token}",
        "summary": "",
        "description": "",
        "tags": [
          "Calendar"
        ],
        "parameters": [],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/cancel-booking": {
      "get": {
        "operationId": "get-cancel-booking",
        "summary": "",
        "description": "",
        "tags": [
          "Cancel-booking"
        ],
        "parameters": [],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/event/{id}/calendar": {
      "get": {
        "operationId": "get-event-{id}-calendar",
        "summary": "",
        "description": "",
        "tags": [
          "Event"
        ],
        "parameters": [],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/timetable": {
      "get": {
        "operationId": "get-timetable",
        "summary": "",
        "description": "",
        "tags": [
          "Timetable"
        ],
        "parameters": [],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/timetable/public": {
      "get": {
        "operationId": "get-timetable-public",
        "summary": "Get public timetable (published events only)",
        "description": "Returns published events for the given date range. Used by the mobile app timetable. Requires start and end in YYYY-MM-DD format.",
        "tags": [
          "Timetable"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "schema": {},
            "required": false
          },
          {
            "in": "query",
            "name": "end",
            "schema": {},
            "required": false
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  }
}