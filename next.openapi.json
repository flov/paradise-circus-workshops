{
  "openapi": "3.0.0",
  "info": {
    "title": "Paradise Circus API",
    "version": "1.0.0",
    "description": "Workshop booking and community platform API for flow artists. Consumed by the web app and mobile app."
  },
  "servers": [
    { "url": "http://localhost:3000/api", "description": "Local development" },
    { "url": "https://paradisecircus.com/api", "description": "Production" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Clerk session token"
      }
    }
  },
  "defaultResponseSet": "common",
  "responseSets": {
    "common": ["400", "404", "500"],
    "auth": ["400", "401", "403", "404", "500"],
    "public": ["400", "404", "500"]
  },
  "errorConfig": {
    "template": {
      "type": "object",
      "properties": {
        "error": { "type": "string", "example": "{{ERROR_MESSAGE}}" }
      }
    },
    "codes": {
      "400": { "description": "Bad Request", "variables": { "ERROR_MESSAGE": "Invalid request parameters" } },
      "401": { "description": "Unauthorized", "variables": { "ERROR_MESSAGE": "Authentication required" } },
      "403": { "description": "Forbidden", "variables": { "ERROR_MESSAGE": "Access denied" } },
      "404": { "description": "Not Found", "variables": { "ERROR_MESSAGE": "Resource not found" } },
      "500": { "description": "Internal Server Error", "variables": { "ERROR_MESSAGE": "An unexpected error occurred" } }
    }
  },
  "apiDir": "./app/api",
  "routerType": "app",
  "schemaDir": "./lib",
  "schemaType": "zod",
  "schemaFiles": [],
  "docsUrl": "api-docs",
  "ui": "scalar",
  "outputFile": "openapi.json",
  "outputDir": "./public",
  "includeOpenApiRoutes": false,
  "ignoreRoutes": ["**/webhooks/**"],
  "debug": false
}
